# Groq LLM API Key (Free tier at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Token (For inference embeddings)
HF_TOKEN=your_huggingface_token_here

# Vector Store Selection: 'chromadb' (local) or 'pinecone' (cloud)
VECTOR_STORE_TYPE=chromadb
CHROMA_DB_PATH=./chroma_db

# Pinecone Vector Store Credentials (Only required if VECTOR_STORE_TYPE=pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=askmydoc

# OCR Space API Key (For scanned PDFs fallback. 'helloworld' is a free public key)
OCR_API_KEY=helloworld

# Backend Server Configuration
PORT=8000
HOST=127.0.0.1
