# LLM Configuration ('ollama' or 'groq')
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
# Seconds to wait for Ollama to accept a connection before falling back to Groq (needs GROQ_API_KEY)
OLLAMA_CONNECT_TIMEOUT=3
# Read timeout in seconds for Ollama responses; empty = no read timeout
# OLLAMA_READ_TIMEOUT=

# Optional Groq LLM API Key (If using LLM_PROVIDER=groq)
# GROQ_API_KEY=your_groq_api_key_here
# Groq model (used for LLM_PROVIDER=groq, and when Ollama fails at request time and GROQ_API_KEY is set)
GROQ_MODEL=openai/gpt-oss-20b

# Embedding Configuration
EMBEDDING_BATCH_SIZE=32
# Optional: Hugging Face model id or local path (default sentence-transformers/all-MiniLM-L6-v2)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Embeddings run locally by default. Set EMBEDDING_BACKEND=hf_api to use the Hugging Face Inference API (needs HF_TOKEN).
# EMBEDDING_BACKEND=local
HF_TOKEN=your_huggingface_token_here

# Vector Store Selection (Local ChromaDB)
VECTOR_STORE_TYPE=chromadb
CHROMA_DB_PATH=./chroma_db

# OCR Space API Key (For scanned PDFs fallback. 'helloworld' is a free public key)
OCR_API_KEY=helloworld

# Backend Server Configuration
PORT=8000
HOST=127.0.0.1
